sues/590", "repository_url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A", "labels_url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A/issues/590/labels{/name}", "comments_url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A/issues/590/comments", "events_url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A/issues/590/events", "html_url": "https://github.com/Dengnifer/MIPStarRE-A/issues/590", "id": 5495573155, "node_id": "I_kwDOUJyJf88AAAABR4_Kow", "number": 590, "title": "Add Lean deltas to merge-train member commit titles", "user": {"login": "Dengnifer", "id": 89234078, "node_id": "MDQ6VXNlcjg5MjM0MDc4", "avatar_url": "https://avatars.githubusercontent.com/u/89234078?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Dengnifer", "html_url": "https://github.com/Dengnifer", "followers_url": "https://api.github.com/users/Dengnifer/followers", "following_url": "https://api.github.com/users/Dengnifer/following{/other_user}", "gists_url": "https://api.github.com/users/Dengnifer/gists{/gist_id}", "starred_url": "https://api.github.com/users/Dengnifer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Dengnifer/subscriptions", "organizations_url": "https://api.github.com/users/Dengnifer/orgs", "repos_url": "https://api.github.com/users/Dengnifer/repos", "events_url": "https://api.github.com/users/Dengnifer/events{/privacy}", "received_events_url": "https://api.github.com/users/Dengnifer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [{"id": 12025011061, "node_id": "LA_kwDOUJyJf88AAAACzL8bdQ", "url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A/labels/infrastructure", "name": "infrastructure", "color": "ededed", "default": false, "description": "Foundational definitions, shared APIs, or supporting layers", "archived_at": null, "archived_by": null}], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 1, "created_at": "2026-09-18T04:13:53Z", "updated_at": "2026-09-18T05:28:22Z", "closed_at": "2026-09-18T05:28:22Z", "assignee": null, "author_association": "OWNER", "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "<!-- mipstarre-issue-key: merge-train-member-lean-delta-20260918 -->\nThe owner requires the Lean line delta in every merge-commit title on main.\nPR #558 implemented that requirement for ordinary PR merges under #557.\nThe newly merged train in #507 does not yet apply it to member merge commits.\n\nAt main commit7bc9bf889712a736451dbc92685d0f3da8097a9b,\n`local/bin/pr_train.py:125` commits each member with only\n`Merge PR #<number> into reviewed train`. Those commits become part of main\nwhen the train publishes, so their subjects would omit the required delta.\n\nBefore the first live train:\n\n- Reuse the existing `pr_merge.lean_line_delta` and\n  `pr_merge.merge_commit_title` conventions for each train member.\n- Measure each member's contribution against the immediately preceding\n  accepted train state, including any merge resolution. Preserve the\n  existing handling of zero delta and measurement failure and the title's\n  closing-reference sanitization. Do not invent a second counting policy.\n- Add focused fixtures for additions/deletions, zero delta, and sequential\n  members whose deltas must not become cumulative. Verify the subject of\n  every merge commit that the published train would add to main.\n- Preserve member heads, tree contents, topology, claim lifetime, review\n  gates, leased transport and post-push checks.\n\nThis is a narrow integration of the already accepted title policy into the\nalready reviewed train. It does not reopen the owner's transport contract\nor require a server-side member predicate. MAIN has not run a live train;\nthe daemon remains the only publisher of merges. Approved580 and587 are\nqueued for train use after this fix and daemon scheduling.", "closed_by": {"login": "Dengnifer", "id": 89234078, "node_id": "MDQ6VXNlcjg5MjM0MDc4", "avatar_url": "https://avatars.githubusercontent.com/u/89234078?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Dengnifer", "html_url": "https://github.com/Dengnifer", "followers_url": "https://api.github.com/users/Dengnifer/followers", "following_url": "https://api.github.com/users/Dengnifer/following{/other_user}", "gists_url": "https://api.github.com/users/Dengnifer/gists{/gist_id}", "starred_url": "https://api.github.com/users/Dengnifer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Dengnifer/subscriptions", "organizations_url": "https://api.github.com/users/Dengnifer/orgs", "repos_url": "https://api.github.com/users/Dengnifer/repos", "events_url": "https://api.github.com/users/Dengnifer/events{/privacy}", "received_events_url": "https://api.github.com/users/Dengnifer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A/issues/590/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/Dengnifer/MIPStarRE-A/issues/590/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}, "completion_comment_id": 5725612813, "daemon_log": "/home/drx/.cache/mipstarre-dev/watchdog/lanes/pr592.merge.log", "review": 5244483811, "CI_seconds": 421, "no_manual_merge": true, "live_train_run": false}
