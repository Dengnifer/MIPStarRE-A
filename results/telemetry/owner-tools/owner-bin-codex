#!/usr/bin/env bash
# owner-bin-codex — TEMPLATE for the PATH shim deployed at
# ~/.cache/mipstarre-dev/owner-bin/codex by install.sh.  It is the first `codex` on the
# PATH of every dispatched worker/reviewer session and of the main session's launcher
# (local/bin/main-session.sh), so it is the one place where a run-wide invocation policy
# can be applied.
#
# It does three things and nothing else:
#   1. keeps codex's own sandbox but disables multi-agent fan-out, which hit the account's
#      "agent thread limit" and killed big reviews (PR 46/87, 2026-09-04);
#   2. pins the reasoning effort the endpoint actually honours (the astra endpoint reports
#      medium for "ultra"; xhigh is the highest level it honours, measured 2026-09-05);
#   3. applies the run's SPEED TIER, which is the only part of this file that changes
#      during a run.
#
# THE SPEED LINE.  `run_mode.py set speed fast|default` regenerates the DEPLOYED copy from
# this template by replacing the single line that starts with SPEED_ARGS= (the rewrite is
# anchored at the start of the line, so these two examples are safe) with either
#     "SPEED_ARGS=" then "(-c 'service_tier=" priority ")"   for fast, or
#     "SPEED_ARGS=" then "()"                                for default,
# and then calls `install.sh --record codex`, which accepts the new hash only because
# install.sh recorded BOTH renderings in owner-bin/manifest.accepted.  This replaces the
# 2026-09-12 speed-fast.sh / speed-default.sh string surgery, which asserted an exact
# 90-character substring of a generated file and silently no-op'd when it drifted.
# Nothing else in this file may be edited on the host: install.sh refuses to overwrite a
# deployed copy whose hash matches no released rendering.
#
# NOT here: the model choice.  The shim used to rewrite gpt-5.6-sol -> gpt-6-astra, which
# made sessions.jsonl record a model that never ran (events.md, 2026-09-12).  A run-wide
# model override belongs in local/model-policy.json via `models.override` in the run brief,
# where telemetry can see it.
#
# NOT here either: a `tool=<name> version=<sha>` banner.  This shim's stdout is the worker's
# stream; the release it belongs to is in owner-bin/tools-version and its hash in
# owner-bin/manifest.sha256.
set -euo pipefail

SPEED_ARGS=()   # @speed-args@ regenerated by run_mode.py set speed; do not edit by hand
# (install.sh rewrites the line above and nothing else in this file.)

CACHE_ROOT="${MIPSTARRE_CACHE_ROOT:-$HOME/.cache/mipstarre-dev}"
REAL_CODEX="${MIPSTARRE_REAL_CODEX:-$HOME/.local/bin/codex}"
[ -x "$REAL_CODEX" ] || { echo "codex shim: no codex binary at $REAL_CODEX" >&2; exit 4; }

mode_file="$CACHE_ROOT/watchdog/account-mode"
mode=primary
if [ -f "$mode_file" ]; then mode="$(cat "$mode_file")"; fi
case "$mode" in primary|both) ;; *) echo 'invalid account mode' >&2; exit 4 ;; esac
if [ "$mode" = primary ] && [ "${CODEX_HOME:-$HOME/.codex}" != "$HOME/.codex" ]; then
  echo 'primary-only policy: preserve the old thread; use a checkpoint continuation' >&2
  exit 4
fi

args=(); task=0; effort=ultra; model=gpt-6-astra
while [ "$#" -gt 0 ]; do
  argument="$1"; shift
  if [ "$argument" = -- ]; then args+=(-- "$@"); task=1; break; fi
  case "$argument" in
    --enable|--enable=*)
      feature="${argument#--enable=}"
      if [ "$argument" = --enable ]; then feature="${1:?missing feature}"; shift; fi
      case "$feature" in *multi_agent*) echo 'fan-out must remain disabled' >&2; exit 4 ;; esac
      args+=(--enable "$feature"); continue ;;
    -m|--model)
      case "${1:-}" in gpt-6-astra|gpt-5.6-sol) model="$1" ;; *) exit 4 ;; esac
      shift; continue ;;
    --model=*)
      model="${argument#--model=}"
      case "$model" in gpt-6-astra|gpt-5.6-sol) ;; *) exit 4 ;; esac
      continue ;;
    -c|--config)
      value="${1:?missing config value}"; shift ;;
    --config=*|-c?*) value="${argument#*=}"; [ "$argument" != "${argument#-c}" ] && value="${argument#-c}" ;;
    *) args+=("$argument"); continue ;;
  esac
  normalized="${value//[[:space:]]/}"
  normalized="${normalized//\"/}"; normalized="${normalized//\'/}"
  case "$normalized" in
    features=*|agents=*) echo 'whole feature/agent table overrides are forbidden' >&2; exit 4 ;;
    model=*) model="${normalized#*=}"; case "$model" in gpt-6-astra|gpt-5.6-sol) ;; *) exit 4 ;; esac; continue ;;
    model_reasoning_effort=*)
      case "${normalized#*=}" in
        max|xhigh) effort="${normalized#*=}" ;;
        ultra) effort=ultra ;;
        *) echo 'effort must be max or xhigh (legacy ultra maps to max)' >&2; exit 4 ;;
      esac
      continue ;;
    features.multi_agent=*|agents.max_concurrent_threads_per_session=*)
      continue ;;
    service_tier=*) continue ;;
  esac
  args+=(-c "$value")
done
if [ "$task" -eq 1 ] && [ "${#args[@]}" -gt 0 ]; then
  last=$(( ${#args[@]} - 1 ))
  args[$last]="Complete this task in the current session. Do not use collaboration tools or spawn subagents.

${args[$last]}"
fi
[ "$model" != gpt-6-astra ] || effort=xhigh
exec "$REAL_CODEX" -m "$model" -c "model_reasoning_effort=\"$effort\"" \
  ${SPEED_ARGS[@]+"${SPEED_ARGS[@]}"} \
  -c 'features.multi_agent=false' -c 'agents.max_concurrent_threads_per_session=1' "${args[@]}"
