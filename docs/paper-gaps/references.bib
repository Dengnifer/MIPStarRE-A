% Bibliography for the paper-gap notes.
%
% One entry per source this project cites.  `SourcePaper` is the key
% `docs/paper-gaps/template.tex` cites; fill it in with the paper being
% formalized (scripts/bootstrap_project.py knows its title and arXiv id) and add
% one entry per further source as the notes start citing it.
@misc{SourcePaper,
  author       = {{The authors}},
  title        = {{The paper this project formalizes}},
  year         = {2026},
  note         = {arXiv:0000.00000},
}

% Cross-references between paper-gap notes.  texra-blueprint resolves the
% "gap:<slug>" keys from the index it generates when the notes are published as
% a site; an entry here lets the same \cite command resolve in the standalone
% latexmk build driven by the Makefile in this directory.  One per note that is
% cited by another note, for example:
%
% @misc{gap:some-topic,
%   author       = {{The project}},
%   title        = {What the note establishes},
%   year         = {2026},
%   howpublished = {Paper-gap note \path{docs/paper-gaps/some-topic.tex}},
% }
