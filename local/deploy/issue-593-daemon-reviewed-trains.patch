--- a/merge-daemon-v9k-cpa.sh
+++ b/merge-daemon-v9k-cpa.sh
@@ -13,4 +13,5 @@
 cd "$HOME/MIPStarRE-qpbt" || exit 1
 PAR="${PAR:-0}"
+[ "$PAR" = 0 ] || { echo "reviewed daemon requires PAR=0" >&2; exit 1; }
 echo $$ > "$D/daemon.pid"   # restart with: kill "$(cat $D/daemon.pid)" (refresh subshells share this cmdline; never pgrep-kill them)
 log() { echo "== $(date -u +%FT%TZ) $*"; }
@@ -58,2 +59,3 @@
 while true; do
+  [ -e "$D/train-approved.running.json" ] && { log "reviewed train needs manual reconciliation ($D/train-approved.running.json); exiting"; exit 1; }
   [ -e "$D/stop" ] && { log "stop file present; exiting"; exit 0; }
@@ -82,1 +84,18 @@
+  if [ -f "$D/train-approved.json" ]; then
+    if [ "$(refreshing_count)" -ne 0 ]; then
+      log "reviewed train held: refresh still running"
+      sleep 45
+      continue
+    fi
+    mv "$D/train-approved.json" "$D/train-approved.running.json" || { log "train admission rename failed"; exit 1; }
+    if printf '%s\n' "${CANDS[@]}" | python3 "$PWD/local/bin/daemon_train.py" \
