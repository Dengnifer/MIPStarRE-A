+      mv "$D/train-approved.running.json" "$D/train-approved.done.json" || { log "train completed but receipt rename failed; reconcile"; exit 1; }
+      log "reviewed train completed; inspect $D/train.log and retained train publication evidence for actual members"
+    else
+      log "reviewed train refused or incomplete; inspect $D/train.log and publication evidence; no automatic retry"
+      exit 1
+    fi
+    continue
+  fi
   # phase B first: merge every fresh candidate, re-fetching after each merge (a merge makes the others stale)
